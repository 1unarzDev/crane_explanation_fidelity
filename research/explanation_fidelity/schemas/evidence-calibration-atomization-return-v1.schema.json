{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crane.local/schemas/evidence-calibration-atomization-return-v1.schema.json",
  "title": "Method-blind atomic decomposition return",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "opaque_response_id", "claims", "unresolved_spans", "attestation"],
  "properties": {
    "schema": {"type": "string", "const": "crane-evidence-calibration-atomization-return/v1"},
    "opaque_response_id": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["response_span", "claim_text", "asserted_abstraction_level"],
        "properties": {
          "response_span": {"type": "string", "minLength": 1},
          "claim_text": {"type": "string", "minLength": 1},
          "asserted_abstraction_level": {
            "type": "string",
            "enum": ["task_outcome", "software_action_failure", "recovery_mechanism", "command_motion_discrepancy", "physical_execution_mechanism", "specific_physical_cause"]
          }
        }
      }
    },
    "unresolved_spans": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "attestation": {"type": "string", "const": "METHOD_BLIND_EXHAUSTIVE_EXTRACTION_ATTEMPT"}
  }
}
