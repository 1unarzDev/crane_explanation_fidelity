{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crane.local/schemas/evidence-calibration-contextual-attachment-return-v1-development.schema.json",
  "title": "Unqualified contextual attachment return; no model execution authorized",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "opaque_response_id",
    "input_sha256",
    "ontology_sha256",
    "claim_attachments",
    "attestation"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "crane-contextual-claim-attachment-return/v1-development"
    },
    "opaque_response_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ontology_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_attachments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "contextual_proposition",
          "stance",
          "polarity",
          "scope",
          "referent_status",
          "attachment_status",
          "proposed_contract_id",
          "context_quotes",
          "scope_note"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "contextual_proposition": {
            "type": "string",
            "minLength": 1
          },
          "stance": {
            "type": "string",
            "enum": [
              "ASSERTED_FACT",
              "HEDGED_CURRENT_EPISODE",
              "INFERENCE_LIMITATION",
              "UNENDORSED_HYPOTHETICAL_OR_QUOTE",
              "UNRESOLVED"
            ]
          },
          "polarity": {
            "type": "string",
            "enum": [
              "NEGATIVE",
              "NOT_APPLICABLE",
              "POSITIVE"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "EPISODE_EVENT",
              "EVIDENTIAL_LIMITATION",
              "GENERAL_OR_HYPOTHETICAL",
              "SOURCE_OR_CONFIG_FACT",
              "UNRESOLVED"
            ]
          },
          "referent_status": {
            "type": "string",
            "enum": [
              "RESOLVED",
              "UNRESOLVED"
            ]
          },
          "attachment_status": {
            "type": "string",
            "enum": [
              "NOT_APPLICABLE",
              "OUT_OF_CATALOG",
              "PROPOSED_MATCH",
              "UNRESOLVED"
            ]
          },
          "proposed_contract_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "context_quotes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "start",
                "end",
                "text"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "ANSWER",
                    "QUESTION"
                  ]
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "scope_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attestation": {
      "type": "string",
      "const": "UNQUALIFIED_CONTEXTUAL_ATTACHMENT_PROPOSAL"
    }
  }
}
