{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crane.local/schemas/claim-aware-realization-v1.schema.json",
  "title": "Constrained claim-aware realization output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "realizer_id", "realizer_version", "plan_sha256", "candidate_sha256", "final_response", "final_clauses", "audit"],
  "properties": {
    "schema": {"const": "crane-claim-aware-realization/v1"},
    "realizer_id": {"type": "string", "minLength": 1}, "realizer_version": {"type": "string", "minLength": 1},
    "plan_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "final_response": {"type": "string", "minLength": 1},
    "final_clauses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clause"}},
    "audit": {"$ref": "explanation-audit-v1.schema.json"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clause": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_id", "kind", "contract_id", "text", "numeric_slot_ids"],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["CLAIM", "NON_ENTAILMENT"]},
        "contract_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "numeric_slot_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
