{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crane.local/schemas/evidence-calibration-contextual-attachment-input-v1-development.schema.json",
  "title": "Unqualified contextual attachment input; no model execution authorized",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "opaque_response_id",
    "question_text",
    "response_text",
    "claims"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "crane-contextual-claim-attachment-input/v1-development"
    },
    "opaque_response_id": {
      "type": "string",
      "minLength": 1
    },
    "question_text": {
      "type": "string",
      "minLength": 1
    },
    "response_text": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "claim_text",
          "response_span"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "response_span": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "text"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
