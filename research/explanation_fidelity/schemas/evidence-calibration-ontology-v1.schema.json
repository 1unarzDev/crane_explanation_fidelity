{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crane.local/schemas/evidence-calibration-ontology-v1.schema.json",
  "title": "CRANE evidence-calibration ontology",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "catalog_version", "evidence_requirements", "claim_contracts", "non_entailments", "diagnostic_nodes"],
  "properties": {
    "schema": {"const": "crane-evidence-calibration-ontology/v1"},
    "catalog_id": {"$ref": "#/$defs/id"},
    "catalog_version": {"$ref": "#/$defs/id"},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "claim_contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "non_entailments": {"type": "array", "items": {"$ref": "#/$defs/non_entailment"}},
    "diagnostic_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "id_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["key", "value"],
      "properties": {"key": {"$ref": "#/$defs/id"}, "value": {"type": ["boolean", "integer", "number", "string"]}}
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "evidence_roles", "predicate_id", "predicate_version", "description"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/id"},
        "evidence_roles": {"$ref": "#/$defs/id_array", "minItems": 1},
        "predicate_id": {"$ref": "#/$defs/id"},
        "predicate_version": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/id"},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}
      }
    },
    "numeric_slot": {
      "type": "object", "additionalProperties": false, "required": ["slot_id", "unit"],
      "properties": {"slot_id": {"$ref": "#/$defs/id"}, "unit": {"$ref": "#/$defs/id"}, "tolerance": {"type": ["number", "null"], "minimum": 0}}
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "proposition", "mechanism_family", "claim_kind", "diagnostic_node_id", "required_evidence_ids"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"}, "proposition": {"$ref": "#/$defs/id"},
        "mechanism_family": {"$ref": "#/$defs/id"},
        "claim_kind": {"enum": ["OBSERVATION", "TASK_OUTCOME", "SOFTWARE_ACTION", "RECOVERY_MECHANISM", "EXECUTION_DISCREPANCY", "PHYSICAL_MECHANISM", "SPECIFIC_PHYSICAL_CAUSE", "LIMITATION", "FALSE_PREMISE_REJECTION"]},
        "diagnostic_node_id": {"$ref": "#/$defs/id"},
        "required_evidence_ids": {"$ref": "#/$defs/id_array", "minItems": 1},
        "optional_evidence_ids": {"$ref": "#/$defs/id_array"},
        "non_entailment_ids": {"$ref": "#/$defs/id_array"},
        "numeric_slots": {"type": "array", "items": {"$ref": "#/$defs/numeric_slot"}},
        "limitations": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "non_entailment": {
      "type": "object", "additionalProperties": false,
      "required": ["non_entailment_id", "basis_claim_ids", "unsupported_consequent_claim_ids", "rationale"],
      "properties": {
        "non_entailment_id": {"$ref": "#/$defs/id"},
        "basis_claim_ids": {"$ref": "#/$defs/id_array", "minItems": 1},
        "unsupported_consequent_claim_ids": {"$ref": "#/$defs/id_array", "minItems": 1},
        "rationale": {"$ref": "#/$defs/id"},
        "additional_evidence_requirement_ids": {"$ref": "#/$defs/id_array"}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "mechanism_family", "label", "rank_within_family", "parent_node_ids", "claim_ids"],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"}, "mechanism_family": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/id"}, "rank_within_family": {"type": "integer", "minimum": 0},
        "parent_node_ids": {"$ref": "#/$defs/id_array"},
        "claim_ids": {"$ref": "#/$defs/id_array", "minItems": 1},
        "required_evidence_ids": {"$ref": "#/$defs/id_array"},
        "contradiction_claim_ids": {"$ref": "#/$defs/id_array"}
      }
    }
  }
}
