{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crane.local/schemas/evidence-calibration-reference-v1.schema.json",
  "title": "Evaluator-only evidence-calibration reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reference_id", "episode_id", "configuration_id", "contract_catalog_id", "contract_catalog_sha256", "condition_bundle_sha256", "reference_builder_id", "reference_builder_version", "reference_builder_sha256", "physical_truth", "conditions", "method_visible"],
  "properties": {
    "schema": {"const": "crane-evidence-calibration-reference/v1"},
    "reference_id": {"$ref": "#/$defs/id"}, "episode_id": {"$ref": "#/$defs/id"},
    "configuration_id": {"$ref": "#/$defs/id"}, "contract_catalog_id": {"$ref": "#/$defs/id"},
    "contract_catalog_sha256": {"$ref": "#/$defs/sha256"}, "condition_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "reference_builder_id": {"$ref": "#/$defs/id"}, "reference_builder_version": {"$ref": "#/$defs/id"},
    "reference_builder_sha256": {"$ref": "#/$defs/sha256"},
    "physical_truth": {"$ref": "#/$defs/physical_truth"},
    "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition_reference"}},
    "method_visible": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "truth_assertion": {
      "type": "object", "additionalProperties": false, "required": ["truth_id", "description"],
      "properties": {"truth_id": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/id"}}
    },
    "physical_truth": {
      "type": "object", "additionalProperties": false,
      "required": ["physical_true_claim_ids", "physical_false_claim_ids", "truth_assertions", "truth_source_references"],
      "properties": {
        "physical_true_claim_ids": {"$ref": "#/$defs/id_array"},
        "physical_false_claim_ids": {"$ref": "#/$defs/id_array"},
        "truth_assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/truth_assertion"}},
        "truth_source_references": {"$ref": "#/$defs/id_array", "minItems": 1}
      }
    },
    "claim_evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "support_label", "physically_true", "physically_false", "required_evidence_ids", "missing_requirement_ids", "invalid_requirement_ids", "contradicted_requirement_ids", "support_references"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "support_label": {"enum": ["SUPPORTED_BY_VISIBLE_EVIDENCE", "CONTRADICTED_BY_VISIBLE_EVIDENCE", "INSUFFICIENT_VISIBLE_EVIDENCE", "PHYSICALLY_TRUE_BUT_UNSUPPORTED"]},
        "physically_true": {"type": "boolean"}, "physically_false": {"type": "boolean"},
        "required_evidence_ids": {"$ref": "#/$defs/id_array"},
        "missing_requirement_ids": {"$ref": "#/$defs/id_array"},
        "invalid_requirement_ids": {"$ref": "#/$defs/id_array"},
        "contradicted_requirement_ids": {"$ref": "#/$defs/id_array"},
        "support_references": {"$ref": "#/$defs/id_array"}
      }
    },
    "condition_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "level_index", "method_packet_sha256", "reference_state", "highest_defensible_node_ids", "supported_required_claim_ids", "optional_supported_claim_ids", "explicitly_unsupported_claim_ids", "contradicted_claim_ids", "ambiguous_claim_ids", "physically_true_but_unsupported_claim_ids", "false_premise", "decisive_evidence_ids", "missing_decisive_requirement_ids", "independent_computation_references", "claim_evaluations"],
      "properties": {
        "condition_id": {"$ref": "#/$defs/id"}, "level_index": {"type": "integer", "minimum": 0},
        "method_packet_sha256": {"$ref": "#/$defs/sha256"},
        "reference_state": {"enum": ["KNOWN", "SUPPORTED_PARTIAL", "AMBIGUOUS", "INSUFFICIENT_EVIDENCE", "FALSE_PREMISE", "NOT_TRIGGERED"]},
        "highest_defensible_node_ids": {"$ref": "#/$defs/id_array"},
        "supported_required_claim_ids": {"$ref": "#/$defs/id_array"},
        "optional_supported_claim_ids": {"$ref": "#/$defs/id_array"},
        "explicitly_unsupported_claim_ids": {"$ref": "#/$defs/id_array"},
        "contradicted_claim_ids": {"$ref": "#/$defs/id_array"},
        "ambiguous_claim_ids": {"$ref": "#/$defs/id_array"},
        "physically_true_but_unsupported_claim_ids": {"$ref": "#/$defs/id_array"},
        "false_premise": {"type": "boolean"},
        "decisive_evidence_ids": {"$ref": "#/$defs/id_array"},
        "missing_decisive_requirement_ids": {"$ref": "#/$defs/id_array"},
        "independent_computation_references": {"$ref": "#/$defs/id_array", "minItems": 1},
        "claim_evaluations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim_evaluation"}}
      }
    }
  }
}
