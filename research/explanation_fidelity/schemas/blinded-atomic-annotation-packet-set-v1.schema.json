{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crane.local/schemas/blinded-atomic-annotation-packet-set-v1.schema.json",
  "title": "Two-pass blinded atomic-claim annotation packet set",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "builder_id", "builder_version", "packet_count", "independent_annotator_count_required", "automated_judge_role", "forms"],
  "properties": {
    "schema": {"const": "crane-blinded-atomic-annotation-packet-set/v1"},
    "builder_id": {"type": "string"}, "builder_version": {"type": "string"},
    "packet_count": {"const": 2}, "independent_annotator_count_required": {"const": 2},
    "automated_judge_role": {"const": "SECONDARY_SENSITIVITY_ONLY"},
    "forms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/form"}}
  },
  "$defs": {
    "nullable_string": {"type": ["string", "null"]},
    "form": {
      "type": "object", "additionalProperties": false,
      "required": ["form_id", "annotator_slot", "packet_id", "rubric_id", "question_text", "robot_visible_evidence", "sanitized_physical_facts", "atomic_statements", "allowed_claim_labels", "required_unit_coverage", "highest_asserted_abstraction_level", "abstraction_level_options", "limitation_preservation", "false_premise_handling", "annotator_attestation"],
      "properties": {
        "form_id": {"type": "string"}, "annotator_slot": {"enum": ["A", "B"]}, "packet_id": {"type": "string"},
        "rubric_id": {"type": "string"}, "question_text": {"type": "string"}, "robot_visible_evidence": {},
        "sanitized_physical_facts": {"type": "array", "items": {"type": "object"}},
        "atomic_statements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "allowed_claim_labels": {"type": "array", "minItems": 5, "maxItems": 5},
        "required_unit_coverage": {"type": "array", "items": {"type": "object"}},
        "highest_asserted_abstraction_level": {"$ref": "#/$defs/nullable_string"},
        "abstraction_level_options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitation_preservation": {"type": "array", "items": {"type": "object"}},
        "false_premise_handling": {"$ref": "#/$defs/nullable_string"},
        "annotator_attestation": {"$ref": "#/$defs/nullable_string"}
      }
    }
  }
}
