{
  "schema": "crane-diagnostic-composition-registry/v1",
  "registry_id": "crane-land-diagnostic-composition-v1-development",
  "model_scope": "Selected land-navigation geometry, command-to-motion, route-change, and recorded runtime-dependency mechanisms represented by this finite development registry.",
  "out_of_model_possible": true,
  "predicates": [
    "action_aborted",
    "action_succeeded",
    "command_motion_not_triggered",
    "command_motion_supported",
    "command_motion_evidence_insufficient",
    "decision_dependency_proven",
    "geometry_sufficient",
    "geometry_supported",
    "geometry_not_restricted",
    "geometry_evidence_insufficient",
    "deadline_source_qualified",
    "deadline_timing_aligned",
    "nav2_consumption_proven",
    "obstacle_observed",
    "current_observation_clear",
    "planning_representation_obstacle",
    "representation_timing_inconsistent",
    "response_recovered",
    "route_change_observed"
  ],
  "mutually_exclusive": [
    ["action_aborted", "action_succeeded"],
    ["command_motion_not_triggered", "command_motion_supported"]
  ],
  "implications": [
    {
      "if": {"predicate": "geometry_supported", "value": true},
      "then": {"predicate": "geometry_sufficient", "value": true}
    },
    {
      "if": {"predicate": "response_recovered", "value": true},
      "then": {"predicate": "command_motion_supported", "value": true}
    },
    {
      "if": {"predicate": "decision_dependency_proven", "value": true},
      "then": {"predicate": "nav2_consumption_proven", "value": true}
    }
  ],
  "mechanisms": [
    {
      "id": "observation_linked_navigation_response",
      "priority": 50,
      "requires": [
        {"predicate": "obstacle_observed", "value": true},
        {"predicate": "nav2_consumption_proven", "value": true},
        {"predicate": "decision_dependency_proven", "value": true},
        {"predicate": "route_change_observed", "value": true}
      ],
      "causal_language_level": "runtime_dependency",
      "claim": "The retained runtime dependency links the observed obstacle input to the recorded navigation response.",
      "required_unit_ids": ["observed-condition", "runtime-consumption", "decision-dependency", "navigation-response"]
    },
    {
      "id": "stale_or_inconsistent_planning_representation",
      "priority": 45,
      "requires": [
        {
          "predicate": "current_observation_clear",
          "value": true
        },
        {
          "predicate": "planning_representation_obstacle",
          "value": true
        },
        {
          "predicate": "representation_timing_inconsistent",
          "value": true
        }
      ],
      "causal_language_level": "observed_model_inconsistency",
      "claim": "The retained current observation and planning representation establish a stale or inconsistent model state.",
      "required_unit_ids": [
        "current-observation",
        "planning-representation",
        "timing-comparison",
        "origin-limit"
      ]
    },
    {
      "id": "geometric_route_restriction",
      "priority": 40,
      "requires": [
        {"predicate": "geometry_sufficient", "value": true},
        {"predicate": "geometry_supported", "value": true}
      ],
      "causal_language_level": "modeled_physical_mechanism",
      "claim": "The audited geometry and active envelope establish a restriction in the reconstructed navigation model.",
      "required_unit_ids": ["geometry-comparison", "model-scope-limit"]
    },
    {
      "id": "measured_response_recovery",
      "priority": 35,
      "requires": [
        {"predicate": "command_motion_supported", "value": true},
        {"predicate": "response_recovered", "value": true}
      ],
      "causal_language_level": "execution_mechanism",
      "claim": "Measured response recovered after a supported command-to-motion discrepancy.",
      "required_unit_ids": ["discrepancy-comparison", "response-recovery", "task-outcome"]
    },
    {
      "id": "deadline_aligned_abort",
      "priority": 28,
      "requires": [
        {"predicate": "action_aborted", "value": true},
        {"predicate": "deadline_source_qualified", "value": true},
        {"predicate": "deadline_timing_aligned", "value": true}
      ],
      "causal_language_level": "bounded_execution_mechanism",
      "claim": "The recorded abort is aligned with the source-qualified task deadline; this does not establish why navigation remained incomplete.",
      "required_unit_ids": ["deadline-comparison", "retained-execution", "geometry-limit"]
    },
    {
      "id": "command_to_motion_discrepancy",
      "priority": 30,
      "requires": [
        {"predicate": "command_motion_supported", "value": true}
      ],
      "causal_language_level": "execution_mechanism",
      "claim": "Delivered command and measured motion establish a command-to-motion discrepancy.",
      "required_unit_ids": ["healthy-comparator", "discrepancy-comparison", "cause-limit"]
    },
    {
      "id": "nominal_command_motion",
      "priority": 20,
      "requires": [
        {"predicate": "command_motion_not_triggered", "value": true},
        {"predicate": "action_succeeded", "value": true}
      ],
      "causal_language_level": "observed_and_computed",
      "claim": "The declared command-to-motion diagnostic did not trigger and the action succeeded.",
      "required_unit_ids": ["nominal-comparison", "false-premise-rejection"]
    },
    {
      "id": "nominal_route_geometry",
      "priority": 20,
      "requires": [
        {"predicate": "geometry_sufficient", "value": true},
        {"predicate": "geometry_not_restricted", "value": true},
        {"predicate": "action_succeeded", "value": true}
      ],
      "causal_language_level": "bounded_negative_diagnostic",
      "claim": "The fully covered retained route audit did not trigger the registered geometric restriction and the action succeeded.",
      "required_unit_ids": ["nominal-geometry-comparison", "false-premise-rejection"]
    },
    {
      "id": "command_motion_evidence_insufficient",
      "priority": 25,
      "requires": [
        {"predicate": "command_motion_evidence_insufficient", "value": true}
      ],
      "causal_language_level": "evidence_sufficiency",
      "claim": "The retained evidence is insufficient to determine whether the registered command-to-motion mechanism occurred.",
      "required_unit_ids": ["insufficiency-diagnosis", "retained-execution", "insufficiency-limit"]
    },
    {
      "id": "geometry_evidence_insufficient",
      "priority": 15,
      "requires": [
        {"predicate": "geometry_evidence_insufficient", "value": true}
      ],
      "causal_language_level": "evidence_sufficiency",
      "claim": "The retained evidence is insufficient to determine whether the registered geometric restriction occurred.",
      "required_unit_ids": ["insufficiency-diagnosis", "retained-execution", "geometry-limit"]
    },
    {
      "id": "recorded_route_change",
      "priority": 10,
      "requires": [
        {"predicate": "route_change_observed", "value": true}
      ],
      "causal_language_level": "recorded_sequence",
      "claim": "The retained delivered paths establish a route change, without by themselves establishing its physical trigger.",
      "required_unit_ids": ["path-comparison", "trigger-limit"]
    }
  ]
}
