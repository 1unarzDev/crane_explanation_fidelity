# Cloudflare account identifier used in the R2 S3 endpoint and analytics query.
R2_ACCOUNT_ID=

# Existing private R2 bucket configured for Standard storage.
R2_BUCKET=

# Bucket-scoped R2 S3 credentials with Object Read & Write permission.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Separate, active Cloudflare API token with Account Analytics Read permission for this account.
# This is not the R2 S3 token, Access Key ID, or Secret Access Key.
CLOUDFLARE_API_TOKEN=

# Optional DVC object prefix. Defaults to crane-explanation-fidelity.
R2_PREFIX=crane-explanation-fidelity
